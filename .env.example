# 카카오 JavaScript 키 (REST API 키 아님)
VITE_KAKAO_JAVASCRIPT_KEY=

# 배포된 앱 URL (끝 슬래시 없이 입력, 따옴표 없이)
# 개발: http://localhost:5174
# 운영(Vercel): https://your-project.vercel.app
# 우선순위: VITE_PUBLIC_APP_URL → (없을 때만) window.location.origin
VITE_PUBLIC_APP_URL=

# Supabase (Project Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# E2E / 다중 세션 테스트용 공용 강사 계정 (코드에 하드코딩하지 않음)
TEST_TEACHER_EMAIL=
TEST_TEACHER_PASSWORD=

# Public VAPID key for Web Push subscribe (parent / student / teacher).
# Private key stays in Supabase Edge Function secrets only — never VITE_.
VITE_VAPID_PUBLIC_KEY=

# Server-only on Vercel. Never prefix with VITE_ (must not enter the browser bundle).
# OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
